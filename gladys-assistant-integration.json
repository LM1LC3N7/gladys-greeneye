{
  "manifest_version": 1,
  "type": "device",
  "name": "Demo Devices Template",
  "description": {
    "en": "Starter template showing sensors, a switch, a dimmable light and a smart plug.",
    "fr": "Template de démarrage : capteurs, interrupteur, lampe variable et prise connectée."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/gladysassistant/integration-template-js:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/GladysAssistant/integration-template-js/master/cover.png",
  "categories": ["lighting", "security", "environment"],
  "transports": ["local", "cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "Getting started", "fr": "Pour commencer" },
      "description": {
        "en": "The demo weather station reads real data from the free Open-Meteo API: pick the coordinates to observe. No account, no API key.",
        "fr": "La station météo de démonstration lit de vraies données via l'API gratuite Open-Meteo : choisissez les coordonnées à observer. Pas de compte, pas de clé d'API."
      },
      "links": [
        {
          "url": "https://open-meteo.com/en/docs",
          "label": { "en": "Open-Meteo documentation", "fr": "Documentation Open-Meteo" }
        }
      ]
    },
    {
      "key": "latitude",
      "type": "number",
      "label": { "en": "Latitude", "fr": "Latitude" },
      "description": {
        "en": "Latitude used for the demo weather sensor.",
        "fr": "Latitude utilisée par le capteur météo de démonstration."
      },
      "placeholder": { "en": "e.g. 48.8566", "fr": "ex. 48.8566" },
      "required": true,
      "default": 48.8566,
      "min": -90,
      "max": 90
    },
    {
      "key": "longitude",
      "type": "number",
      "label": { "en": "Longitude", "fr": "Longitude" },
      "description": {
        "en": "Longitude used for the demo weather sensor.",
        "fr": "Longitude utilisée par le capteur météo de démonstration."
      },
      "placeholder": { "en": "e.g. 2.3522", "fr": "ex. 2.3522" },
      "required": true,
      "default": 2.3522,
      "min": -180,
      "max": 180
    },
    {
      "key": "unit",
      "type": "select",
      "label": { "en": "Temperature unit", "fr": "Unité de température" },
      "required": false,
      "default": "celsius",
      "options": [
        { "value": "celsius", "label": { "en": "Celsius", "fr": "Celsius" } },
        { "value": "fahrenheit", "label": { "en": "Fahrenheit", "fr": "Fahrenheit" } }
      ]
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": { "en": "Refresh interval (s)", "fr": "Intervalle de rafraîchissement (s)" },
      "description": {
        "en": "How often sensors are polled, in seconds (one minute minimum).",
        "fr": "Fréquence d'interrogation des capteurs, en secondes (une minute minimum)."
      },
      "required": false,
      "default": 300,
      "min": 60,
      "max": 3600
    }
  ],
  "actions": [
    {
      "key": "test_weather",
      "label": { "en": "Test the weather provider", "fr": "Tester le fournisseur météo" },
      "timeout_seconds": 30
    },
    {
      "key": "identify",
      "label": { "en": "Identify a device", "fr": "Identifier un appareil" },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Device", "fr": "Appareil" },
          "required": true
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "motion_detected",
      "label": { "en": "Motion detected", "fr": "Mouvement détecté" },
      "description": {
        "en": "A demo motion sensor saw a person or an animal move.",
        "fr": "Un détecteur de démonstration a vu bouger une personne ou un animal."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Sensor", "fr": "Détecteur" }
        },
        {
          "key": "target",
          "type": "multi_select",
          "label": { "en": "What moved", "fr": "Ce qui a bougé" },
          "options": [
            { "value": "person", "label": { "en": "Person", "fr": "Personne" } },
            { "value": "animal", "label": { "en": "Animal", "fr": "Animal" } }
          ]
        }
      ],
      "variables": [
        {
          "key": "target",
          "type": "string",
          "label": { "en": "What moved", "fr": "Ce qui a bougé" }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "identify_device",
      "label": { "en": "Identify a device", "fr": "Identifier un appareil" },
      "description": {
        "en": "Make a device signal itself (the demo light blinks).",
        "fr": "Fait se signaler un appareil (la lampe de démonstration clignote)."
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Device", "fr": "Appareil" },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "signalled",
          "type": "boolean",
          "label": { "en": "Device signalled", "fr": "Appareil signalé" }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "demo_status",
      "label": { "en": "Demo status", "fr": "État de la démo" },
      "description": {
        "en": "Live temperature and plug power, plug connection and observed location.",
        "fr": "Température et puissance en direct, connexion de la prise, position observée."
      },
      "icon": "activity",
      "action_timeout_seconds": 15
    }
  ]
}
